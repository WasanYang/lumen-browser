<Window x:Class="MiniBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MiniBrowser" Width="1280" Height="800"
        Background="#1E1E1E"
        PreviewKeyDown="Window_PreviewKeyDown">

  <Window.Resources>
    <Style x:Key="TabButton" TargetType="Button">
      <Setter Property="Foreground" Value="#CCCCCC" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="MaxWidth" Value="200" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="#2D2D2D" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid x:Name="TopBar" Height="34">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="360" />
      </Grid.ColumnDefinitions>

      <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                    Margin="4,4,0,4">
        <StackPanel x:Name="TabStrip" Orientation="Horizontal" />
      </ScrollViewer>

      <Button Grid.Column="1" Content="+" FontSize="16" Margin="4"
              Style="{StaticResource TabButton}" Click="NewTab_Click"
              ToolTip="แท็บใหม่ (Ctrl+T)" />

      <Button x:Name="UBlockButton" Grid.Column="2" Content="↻ uBO" Margin="0,4"
              Style="{StaticResource TabButton}" Click="UpdateUBlock_Click"
              ToolTip="อัปเดต uBlock Origin Lite" />

      <TextBox x:Name="UrlBox" Grid.Column="3" Margin="4,5,6,5" Padding="8,0"
               Background="#2A2A2A" Foreground="#E0E0E0" CaretBrush="#E0E0E0"
               BorderThickness="0" VerticalContentAlignment="Center"
               KeyDown="UrlBox_KeyDown" GotKeyboardFocus="UrlBox_GotKeyboardFocus" />
    </Grid>

    <Grid x:Name="Pages" Grid.Row="1" />
  </Grid>
</Window>
