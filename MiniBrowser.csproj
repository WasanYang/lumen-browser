<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MiniBrowser</AssemblyName>
    <RootNamespace>MiniBrowser</RootNamespace>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3485.44" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="blocklist.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Extensions\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
